{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tkbg-rechner",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "tkbg.de",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
